  "voice": "am_michael",
  "audioSha256": "6d730f8d6cf38d9ef5e13fa949c3ec299ae31f6451c831506c36a192d6bda413",
  "cues": [
    {
      "start": 0.0,
      "end": 6.52,
      "paragraph": 0,
      "ranges": [
        {
          "page": 1,
          "start": 730,
          "end": 825
        }
      ],
      "text": "Louisiana immunizes healthcare providers from civil liability during public health emergencies."
    },
    {
      "start": 6.52,
      "end": 13.02,
      "paragraph": 0,
      "ranges": [
        {
          "page": 1,
          "start": 880,
          "end": 981
        }
      ],
      "text": "Below, the Louisiana Court of Appeal held that this state statute barred plaintiff's federal claims."
    },
    {
      "start": 13.02,
      "end": 15.34,
      "paragraph": 0,
      "ranges": [
        {
          "page": 1,
          "start": 1105,
          "end": 1132
        }
      ],
      "text": "That decision is incorrect."
    },
    {
      "start": 15.34,
      "end": 20.08,
      "paragraph": 0,
      "ranges": [
        {
          "page": 1,
          "start": 1133,
          "end": 1207
        }
      ],
      "text": "Defining the scope of liability under state law is the State's prerogative."
    },
    {
      "start": 20.08,
      "end": 25.34,
      "paragraph": 0,
      "ranges": [
        {
          "page": 1,
          "start": 1208,
          "end": 1282
        }
      ],
      "text": "But a State has no power to confer immunity from federal causes of action."
    },
    {
      "start": 25.34,
      "end": 36.48,
      "paragraph": 0,
      "ranges": [
        {
          "page": 1,
          "start": 1436,
          "end": 1577
        }
      ],
      "text": "“The Judges in every State” are bound to follow federal law, “any Thing in the Constitution or Laws of any state to the Contrary notwithstanding.”"
    },
    {
      "start": 36.48,
      "end": 41.08,
      "paragraph": 1,
      "ranges": [
        {
          "page": 1,
          "start": 1608,
          "end": 1675
        }
      ],
      "text": "Plaintiff's federal claims may well fail on other federal grounds."
    },
    {
      "start": 41.08,
      "end": 45.48,
      "paragraph": 1,
      "ranges": [
        {
          "page": 1,
          "start": 1742,
          "end": 1810
        }
      ],
      "text": "But that is for the Louisiana courts to decide in the first instance."
    },
    {
      "start": 45.48,
      "end": 57.24,
      "paragraph": 1,
      "ranges": [
        {
          "page": 1,
          "start": 1811,
          "end": 1900
        },
        {
          "page": 2,
          "start": 51,
          "end": 145
        }
      ],
      "text": "The petition for certiorari is granted, the judgment of the Louisiana Court of Appeal is reversed, and the case is remanded for further proceedings not inconsistent with this opinion."
    },
    {
      "start": 57.24,
      "end": 58.3,
      "paragraph": 1,
      "ranges": [
        {
          "page": 2,
          "start": 146,
          "end": 163
        }
      ],
      "text": "It is so ordered."
    }
  ],
