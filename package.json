{
  "name": "ninefold",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build_content_version.mjs && node scripts/build_firebase.mjs && python scripts/build_site.py",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-ninefold --only firestore 'node --test tests/firestore.rules.mjs'",
    "test:sync": "firebase emulators:exec --project demo-ninefold --only auth,firestore 'node --test tests/firebase.sync.mjs'",
    "test:editor": "node tests/editor-ui.mjs && node tests/editor-sparse-ui.mjs"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "esbuild": "0.27.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.35.0",
    "jsdom": "31.0.0"
  }
}
